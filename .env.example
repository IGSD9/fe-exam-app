NEXT_PUBLIC_DEFAULT_QUALIFICATION_ID=fe
# 公開URL（Search Console / sitemap 用。本番ドメインに書き換える）
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001

# Supabase（未設定時はローカルストアで動作）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AdSense（Web。publisher ID は公開される値）
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-6139503169440528990
# 広告 > 広告ユニット で作成したバナーのスロット ID（数字のみ）。未設定でも自動広告は可
NEXT_PUBLIC_ADSENSE_BANNER_SLOT=

# RevenueCat / AdMob（ネイティブ変換後に使用）
NEXT_PUBLIC_REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
NEXT_PUBLIC_ADMOB_BANNER_ID=
